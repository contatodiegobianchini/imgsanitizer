{
  "name": "imgsanitizer",
  "version": "1.0.0",
  "description": "Aplicação web open-source para remoção de metadados sensíveis de imagens.",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "rimraf dist && tsc",
    "start": "node dist/src/server.js",
    "check": "tsc --noEmit",
    "test": "npm run check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/contatodiegobianchini/imgsanitizer.git"
  },
  "keywords": [
    "image",
    "metadata",
    "exif",
    "sanitizer",
    "privacy"
  ],
  "author": "Diego Bianchini",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.32.6"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.5",
    "rimraf": "^5.0.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
