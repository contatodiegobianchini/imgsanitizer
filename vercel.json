{
  "version": 2,
  "builds": [
    {
      "src": "src/server.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "src/server.ts"
    },
    {
      "src": "/style.css",
      "dest": "public/style.css"
    },
    {
      "src": "/(.*)",
      "dest": "public/index.html"
    }
  ]
}
